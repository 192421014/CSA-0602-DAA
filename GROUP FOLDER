{
    /* Project dataset */

    Project projects[] = {

        {1, "AI Platform",      20, 120},
        {2, "Mobile App",       30, 150},
        {3, "Cloud Migration",  10,  60},
        {4, "IoT Sensors",      40, 200},
        {5, "Data Warehouse",   15,  90},
        {6, "Security Upgrade", 25, 140}
    };

    int numProjects = 6;

    int resourceCapacity = 70;

    /* Job dataset */

    Job jobs[] = {

        {1, "Design Review",     2,  60},
        {2, "Code Freeze",       1, 100},
        {3, "Client Demo",       3,  20},
        {4, "Server Migration",  2,  40},
        {5, "Final Testing",     1,  20},
        {6, "Deployment",        3,  30}
    };

    int numJobs = 6;

    int maxTimeSlots = 3;

    /* Header */

    printf("=====================================================================\n");
    printf("       SMART RESOURCE ALLOCATION AND OPTIMIZATION SYSTEM\n");
    printf("=====================================================================\n");

    /* Run Dynamic Programming */

    runProjectSelection(
        projects,
        numProjects,
        resourceCapacity
    );

    /* Run Greedy Job Sequencing */

    runJobSequencing(
        jobs,
        numJobs,
        maxTimeSlots
    );

    /* Show Greedy Counterexample */

    greedyKnapsackCounterexample();

    return 0;
}
